# Copy to .env and fill in. .env is gitignored; never commit values.
# Provider keys: project-scoped, with spend limits set in each provider console (the backstop).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
META_API_KEY=
TOGETHER_API_KEY=
OPENFDA_API_KEY=
HF_TOKEN=
# SEC fair-access policy: a real name and contact email, e.g. "Jane Doe jane@example.com".
SEC_USER_AGENT=
# Optional overrides
# TECHBIO_DATA_DIR=data
# TECHBIO_DB_URL=sqlite:///data/ledger.sqlite
